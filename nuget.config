<?xml version="1.0" encoding="utf-8"?>
<!-- Pins restore and tool installs to nuget.org, independent of each machine's own NuGet sources. -->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
</configuration>
